{
  "name": "@arthur.eudeline/starbucks-tp-kit",
  "version": "2.0.15",
  "private": false,
  "exports": {
    "./styles": "./dist/styles.css",
    "./package.json": "./package.json",
    "./tailwind/preset": "./tailwind/preset.js",
    "./tailwind/colors": "./tailwind/colors.js",
    "./tailwind/v4": "./tailwind/v4.css",
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.mjs",
      "require": "./dist/data/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "type": "commonjs",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist",
    "tailwind",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf ./dist && postcss src/main.css -o ./dist/styles.css && tsup",
    "dev": "postcss src/main.css -o ./dist/styles.css --watch & tsup --watch",
    "publish:local": "yalc push",
    "lint": "publint"
  },
  "publishConfig": {
    "@arthur.eudeline-cours:registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "class-variance-authority": "^0.7.0",
    "i18next": "^23.4.1",
    "lucide-react": "^0.427.0",
    "zod": "^3.21.4",
    "zod-i18n-map": "^2.14.0",
    "@tailwindcss/typography": "^0.5.9"
  },
  "peerDependencies": {
    "@headlessui/react": ">1.7.16",
    "@mantine/form": "^7",
    "@phosphor-icons/react": "^2.0.10",
    "next": ">13",
    "react": "^19",
    "react-dom": "^19",
    "typescript": ">4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/eslint__js": "^8.42.3",
    "@types/glob": "^8.1.0",
    "@types/node": "^22.1.0",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "autoprefixer": "^10",
    "cssnano": "^7.0.4",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^6.0.0",
    "eslint-plugin-cypress": "^2.11.3",
    "eslint-plugin-flowtype": "^4",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-react-namespace-import": "^1.0.5",
    "eslint-plugin-storybook": "^0.8.0",
    "glob": "^11.0.0",
    "postcss": "^8",
    "postcss-cli": "^11.0.0",
    "publint": "^0.2.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1"
  }
}
