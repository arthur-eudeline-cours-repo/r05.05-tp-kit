{
  "name": "@arthur.eudeline/starbucks-tp-kit-sb",
  "version": "2.0.2",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o ./.build --disable-telemetry",
    "start": "http-server ./.build -p 6006 --gzip --brotli",
    "docker:build" : "docker build ../../ --tag arthureudeline/starbucks-tp-kit-storybook:latest --tag arthureudeline/starbucks-tp-kit-storybook:2.0.2",
    "docker:push": "docker push arthureudeline/starbucks-tp-kit-storybook -a"
  },
  "dependencies": {
    "@arthur.eudeline/starbucks-tp": "workspace:*",
    "@arthur.eudeline/starbucks-tp-kit": "workspace:*",
    "http-server": "14.1.1",
    "lucide-react": "^0.427.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.2.8",
    "@storybook/addon-interactions": "^8.2.8",
    "@storybook/addon-links": "^8.2.8",
    "@storybook/addon-onboarding": "^8.2.8",
    "@storybook/addon-styling-webpack": "^1.0.0",
    "@storybook/blocks": "^8.2.8",
    "@storybook/manager-api": "^8.2.8",
    "@storybook/nextjs": "^8.2.8",
    "@storybook/react": "^8.2.8",
    "@storybook/test": "^8.2.8",
    "@storybook/theming": "^8.2.8",
    "@types/node": "^22.1.0",
    "eslint-plugin-storybook": "^0.8.0",
    "next": "^14",
    "postcss": "^8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.2.8"
  }
}
