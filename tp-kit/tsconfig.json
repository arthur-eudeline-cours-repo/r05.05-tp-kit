{
  "compilerOptions": {
    // "target": "es5",
    "target": "ES2022",
    // "lib": ["dom", "dom.iterable", "esnext"],
    "lib": [
      "DOM",
      "ESNext",
      "DOM.Iterable"
    ],
    // "allowJs": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    // "moduleResolution": "bundler",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // "jsx": "preserve",
    "jsx": "react-jsx",
    // "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    // Volontairement aucun alias `@/*` ici : les sources du kit sont compilées telles quelles par
    // les apps qui les consomment (transpilePackages / Vite), où `@/*` pointe déjà sur *leur* src.
    // Les imports internes restent relatifs ; c'est `scripts/fix-registry-imports.mjs` qui les
    // convertit en `@/...` dans le registry généré. L'absence de `paths` fait échouer `tsc` si un
    // `@/...` est réintroduit dans src/.
    "paths": {},
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "declaration": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "importHelpers": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "pretty": true,
    "sourceMap": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "stripInternal": true,
    "types": [
      "node"
    ],
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}